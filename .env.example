# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Used by `npm run db:types` only.
SUPABASE_PROJECT_ID=""

# Canonical origin. Leave unset locally; Vercel supplies its own URL in production.
# Set this once a custom domain exists.
# NEXT_PUBLIC_SITE_URL="https://vvbakes.co.nz"

# Email (Gmail SMTP). Create an app password at
# https://myaccount.google.com/apppasswords — the account password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="youraddress@gmail.com"
SMTP_PASS=""
EMAIL_FROM="vvbakes <youraddress@gmail.com>"

# Shared secret for the daily Supabase keep-alive cron. Any long random string.
CRON_SECRET=""
