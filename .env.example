# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
#
# Run `npm run check` afterwards — it verifies every value without printing any
# of them.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API Keys
#
# The dashboard now calls these the Publishable key and the Secret key. Older
# projects call the same two things anon/public and service_role; the variable
# names below keep the older wording because that is what the Supabase client
# libraries still expect.

# Project URL. Public, appears in every page.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# The Publishable key (starts sb_publishable_). Safe in a browser: row level
# security is what actually protects the data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# The Secret key (starts sb_secret_). Bypasses every security rule, so it is
# server-only and must never go in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=""

# Only used by `npm run db:types`. The bit before .supabase.co in the URL above.
SUPABASE_PROJECT_ID=""

# Canonical origin. Leave unset locally; Vercel supplies its own URL in
# production. Set this once a custom domain exists.
# NEXT_PUBLIC_SITE_URL="https://vvbakes.co.nz"

# Email. Sent through Resend, from a domain verified with them.
# Key from https://resend.com/api-keys — sending permission is enough.
RESEND_API_KEY=""

# Has to sit on the verified domain; this is the only address that gets signed.
# Replies go wherever the admin's contact email points, which can be an ordinary
# mailbox on someone else's domain.
EMAIL_FROM="vvbakes <orders@yourdomain>"

# Signing secret for the Resend webhook that reports bounces and spam
# complaints, from https://resend.com/webhooks. Starts whsec_. Without it
# /api/webhooks/resend refuses every call, and a bounce goes unrecorded.
RESEND_WEBHOOK_SECRET=""

# Shared secret for the daily cron jobs (Supabase keep-alive, Instagram sync).
# Any long random string.
CRON_SECRET=""

# Instagram feed. Optional: leave it blank and the home page simply has no
# Instagram band.
#
# This is only a seed. The first cron run copies it into the database and every
# run after that refreshes it there, because a sixty-day token that lived only
# here would need a redeploy to renew and the feed would go blank without one.
# Once the site has run, changing this value does nothing: see the README.
#
# Get one by making the account Professional (Business or Creator), creating a
# Meta app with "Instagram API with Instagram Login", and exchanging the short
# token for a long-lived one. No App Review is needed for the owner's own
# account while she has a role on the app.
INSTAGRAM_ACCESS_TOKEN=""
